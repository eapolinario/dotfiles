#!/usr/bin/env bash

set -euo pipefail

# sketchybar sources this file at startup and on `sketchybar --reload`.
CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly CONFIG_DIR
readonly PLUGIN_DIR="${CONFIG_DIR}/plugins"

# shellcheck source=./colors.sh
source "${CONFIG_DIR}/colors.sh"

#######
# Bar #
#######

# sticky=on keeps the bar visible on every space, including fullscreen apps.
# AeroSpace reserves this same height with gaps.outer.top.
# notch_width is the region items route around; 200 is the documented default,
# set explicitly so the intent is obvious if a center item is ever added.
sketchybar --bar \
	height=38 \
	notch_width=200 \
	position=top \
	sticky=on \
	padding_left=8 \
	padding_right=8 \
	color="$BAR_COLOR" \
	shadow=off

sketchybar --default \
	icon.font="$BAR_FONT:Bold:14.0" \
	icon.color="$ICON_COLOR" \
	icon.padding_left=8 \
	icon.padding_right=8 \
	label.font="$BAR_FONT:Semibold:13.0" \
	label.color="$LABEL_COLOR" \
	label.padding_left=4 \
	label.padding_right=8 \
	padding_left=2 \
	padding_right=2 \
	background.corner_radius=5 \
	background.height=22

##########
# Spaces #
##########

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_focus_change
sketchybar --add event aerospace_layout_change

while IFS="|" read -r workspace display; do
	[[ -n $workspace ]] || continue

	sketchybar --add item "space.${workspace}" left \
		--set "space.${workspace}" \
		display="$display" \
		icon="$workspace" \
		icon.highlight_color="$ACCENT_COLOR" \
		background.color="$ITEM_BG_COLOR" \
		background.drawing=off \
		label.drawing=off \
		click_script="aerospace workspace ${workspace}" \
		script="${PLUGIN_DIR}/aerospace.sh ${workspace}" \
		--subscribe "space.${workspace}" \
		aerospace_workspace_change aerospace_focus_change
done < <(
	aerospace list-workspaces --all \
		--format "%{workspace}|%{monitor-appkit-nsscreen-screens-id}"
)

#########
# Items #
#########

sketchybar --add item front_app left \
	--set front_app \
	icon.drawing=off \
	label.font="$BAR_FONT:Bold:13.0" \
	script="${PLUGIN_DIR}/front_app.sh" \
	--subscribe front_app front_app_switched

sketchybar --add item layout right \
	--set layout \
	icon="TILE" \
	icon.color="$ACCENT_COLOR" \
	label="?" \
	background.color="$ITEM_BG_COLOR" \
	background.drawing=on \
	script="${PLUGIN_DIR}/layout.sh" \
	--subscribe layout aerospace_focus_change aerospace_layout_change

sketchybar --add item battery right \
	--set battery \
	icon="BAT" \
	background.color="$ITEM_BG_COLOR" \
	background.drawing=on \
	update_freq=120 \
	script="${PLUGIN_DIR}/battery.sh" \
	--subscribe battery power_source_change system_woke

sketchybar --add item system_stats right \
	--set system_stats \
	icon="SYS" \
	background.color="$ITEM_BG_COLOR" \
	background.drawing=on \
	update_freq=30 \
	script="${PLUGIN_DIR}/system_stats.sh"

sketchybar --add item clock right \
	--set clock \
	icon.drawing=off \
	update_freq=30 \
	script="${PLUGIN_DIR}/clock.sh"

focused_workspace="$(aerospace list-workspaces --focused)"
sketchybar --update
sketchybar --trigger aerospace_workspace_change \
	FOCUSED_WORKSPACE="$focused_workspace"
sketchybar --trigger aerospace_layout_change
